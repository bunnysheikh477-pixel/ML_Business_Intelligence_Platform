# Copy this file to .env and fill in real values. Never commit the real .env.

# MongoDB connection string. Required.
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster-host>/<optional-host-params>
MONGODB_DATABASE=ml_bi_platform

# Optional: enable the Gemini-powered assistant features.
GEMINI_API_KEY=

# Upload storage and limits.
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=20

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seconds a generated Plotly chart payload is cached for an unchanged dataset.
CHART_CACHE_TTL_SECONDS=60

# Bundled sample dataset loaded by POST /api/v1/datasets/sample.
SAMPLE_DATASET_PATH=sample_sales.csv
